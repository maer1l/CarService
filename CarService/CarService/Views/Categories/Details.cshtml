@model CarService.Models.Category

@{
    ViewData["Title"] = "Категория";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Категория</h4>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model?.CategoryId" class="btn btn-sm btn-outline-secondary">Edit</a>
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary">← Назад</a>
    </div>
</div>

<div style="border:1px solid #dee2e6; border-radius:8px; overflow:hidden;">
    <dl class="row mb-0">
        <dt class="col-sm-3 bg-light px-3 py-2 mb-0 text-muted small">@Html.DisplayNameFor(model => model.CategoryName)</dt>
        <dd class="col-sm-9 px-3 py-2 mb-0">@Html.DisplayFor(model => model.CategoryName)</dd>
    </dl>
</div>