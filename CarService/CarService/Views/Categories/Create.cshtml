@model CarService.Models.Category

@{
    ViewData["Title"] = "Create";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Создание категории</h4>
    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">← Назад</a>
</div>

<div style="border:1px solid #dee2e6; border-radius:8px; overflow:hidden; max-width:480px;">
    @using (Html.BeginForm("Create", "Categories", FormMethod.Post, new { id = "categoryForm", @class = "p-3" }))
    {
        @Html.ValidationSummary(false, "", new { @class = "text-danger small mb-2" })

        <div class="mb-3">
            @Html.LabelFor(m => m.CategoryName, new { @class = "form-label small text-muted" })

            @Html.TextBoxFor(m => m.CategoryName, new {@class = "form-control form-control-sm", id = "categoryName", placeholder = "Литые диски"})

            @Html.ValidationMessageFor(
                     m => m.CategoryName,
                     "",
                     new { @class = "text-danger small" })
        </div>

        <input type="submit" value="Создать" class="btn btn-sm btn-dark" id="create" />
    }
</div>

<script>
    $('#create').click(function (e) {
        e.preventDefault();

        let jsonData = JSON.stringify({
            'categoryName': $('#categoryName').val()
        });

        $.ajax({
            url: '/Categories/ValidateCategory',
            method: 'post',
            dataType: 'JSON',
            contentType: 'application/json',
            cache: false,
            processData: false,
            data: jsonData,

            success: function (data) {

                $('.field-validation-error').text('');

                if (data.success == true) {
                    $('#categoryForm').submit();
                }
                else {
                    let errors = data.errors;

                    for (let key in errors) {
                        let span = $(`[data-valmsg-for="${key}"]`);
                        span.text(errors[key]);
                    }
                }
            }
        });
    });
</script>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}