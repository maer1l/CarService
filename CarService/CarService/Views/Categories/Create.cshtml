@model CarService.Models.Category

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Category</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        @using (Html.BeginForm("Create", "Categories", FormMethod.Post, new { id = "categoryForm" }))
        {
            @Html.ValidationSummary(false, "Please fix the following errors!")

            <div class="form-group">
                @Html.LabelFor(m => m.CategoryName)
                @Html.TextBoxFor(m => m.CategoryName, new { @class = "form-control", id = "categoryName", placeholder = "Литые диски" })
                @Html.ValidationMessageFor(m => m.CategoryName)
            </div>

            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" id="create" />
            </div>
            <div>
                <a asp-action="Index">Back to List</a>
            </div>
        }
    </div>
</div>

<script>
    $('#create').click(function(e){
        e.preventDefault();
        let jsonData = JSON.stringify({'categoryName': $('#categoryName').val()});
        $.ajax({
            url: '/Categories/ValidateCategory',
            method: 'post',
            dataType: 'JSON',
            contentType: 'application/json',
            cache: false,
            processData: false,
            data: jsonData,
            succsess: function(data){
                if(data.succsess == true){ $('#categoryForm').submit(); }
                else{
                    let errors = data.errors;
                    for(let key in errors){
                        let span = $(`[data-valmsg-for="${key}"]`)
                        span.text(errors[key]);
                    }
                }
            }
        })
    });
</script>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
