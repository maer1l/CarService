@model CarService.Models.Category

@{
    ViewData["Title"] = "Edit";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Редактирование категории</h4>
    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">← Назад</a>
</div>

<div style="border:1px solid #dee2e6; border-radius:8px; overflow:hidden; max-width:480px;">
    <form asp-action="Edit" class="p-3">
        <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>
        <input type="hidden" asp-for="CategoryId" />
        <div class="mb-3">
            <label asp-for="CategoryName" class="form-label small text-muted"></label>
            <input asp-for="CategoryName" class="form-control form-control-sm" />
            <span asp-validation-for="CategoryName" class="text-danger small"></span>
        </div>
        <input type="submit" value="Сохранить" class="btn btn-sm btn-dark" />
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}