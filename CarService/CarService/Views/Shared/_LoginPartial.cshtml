@using Microsoft.AspNetCore.Identity
@using CarService.Areas.Identity.Data

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav">
@if (SignInManager.IsSignedIn(User))
{
    <li class="nav-item">
        <a id="manage" class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage">Hello @UserManager.GetUserName(User)!</a>
    </li>
    <li class="nav-item">
        <form id="logoutForm" class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
            <button id="logout" type="submit" class="nav-link btn btn-link text-dark border-0">Logout</button>
        </form>
    </li>
}
else
{
    <li class="nav-item">
        <div class="nav-link text-dark" onclick="oncl()">Login</div>
    </li>
}
</ul>

<dialog id="login" onclick="isClose(event)">
    <div style="display:flex;flex-direction:column; gap: 5px; justify-content: center; align-items: center;">
        <h2 id="bigText">logIn</h2>
        <form asp-area="Identity" asp-page="/Account/Login">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <div class="form-floating mb-3">
                <input name="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
            </div>
            <div class="form-floating mb-3">
                <input type="password" name="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="password" />
            </div>
            <div>
                <button id="login-submit" type="submit" class="w-100 btn btn-lg btn-primary">Log in</button>
            </div>
        </form>
        <a asp-area="Identity" asp-page="/Account/Register">haven`t account? Register</a>
    </div>
</dialog>

<script>
    function oncl(){
        let dialog = document.getElementById('login');
        dialog.showModal();
    }

    function isClose(event){
        let d = document.getElementById('login');
        let dialog = d.getBoundingClientRect();
        let inside = event.clientX >= dialog.left && event.clientX <= dialog.right && event.clientY <= dialog.bottom && event.clientY >= dialog.top;
        if(!inside) d.close();
    }
</script>