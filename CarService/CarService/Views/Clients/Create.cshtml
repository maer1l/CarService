@model CarService.Models.Client

@{
    ViewData["Title"] = "Create";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Создание клиента</h4>
    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">← Назад</a>
</div>

<div style="border:1px solid #dee2e6; border-radius:8px; overflow:hidden; max-width:520px;">
    <form asp-action="Create" class="p-3">

        <div asp-validation-summary="ModelOnly"
             class="text-danger small mb-2">
        </div>

        <div class="mb-3">
            <label asp-for="DocumentId" class="form-label small text-muted"></label>

            <input asp-for="DocumentId" class="form-control form-control-sm" />

            <span asp-validation-for="DocumentId" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Name" class="form-label small text-muted"></label>

            <input asp-for="Name" class="form-control form-control-sm" />

            <span asp-validation-for="Name" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Address" class="form-label small text-muted"></label>

            <input asp-for="Address" class="form-control form-control-sm" />

            <span asp-validation-for="Address" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Phone" class="form-label small text-muted"></label>

            <input asp-for="Phone" class="form-control form-control-sm" />

            <span asp-validation-for="Phone" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Birthdate" class="form-label small text-muted"></label>

            <input asp-for="Birthdate" class="form-control form-control-sm" />

            <span asp-validation-for="Birthdate" class="text-danger small"></span>
        </div>

        <input type="submit" value="Создать" class="btn btn-sm btn-dark" />
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}