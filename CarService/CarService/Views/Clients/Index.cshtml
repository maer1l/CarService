@model IEnumerable<CarService.Models.Client>

@{
    ViewData["Title"] = "Клиенты";
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h1 class="h4 mb-0">Клиенты</h1>
    <div class="d-flex gap-2 align-items-center flex-wrap">
        <a asp-action="Create" class="btn btn-sm btn-outline-secondary">+ Создать</a>
        <form data-ajax="true" data-ajax-method="post" data-ajax-url="/Clients/SearchClient" data-ajax-update="#results">
            <div class="d-flex gap-2">
                <input type="text" name="word" placeholder="Поиск..." class="form-control form-control-sm" style="width:220px;" />
                <button type="submit" class="btn btn-sm btn-outline-secondary">🔍</button>
            </div>
        </form>
    </div>
</div>

<div id="results">
    <div style="border:1px solid #dee2e6; border-radius:8px; overflow:hidden;">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>@Html.DisplayNameFor(model => model.DocumentId)</th>
                    <th>@Html.DisplayNameFor(model => model.Name)</th>
                    <th>@Html.DisplayNameFor(model => model.Address)</th>
                    <th>@Html.DisplayNameFor(model => model.Phone)</th>
                    <th>@Html.DisplayNameFor(model => model.Birthdate)</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@Html.DisplayFor(modelItem => item.DocumentId)</td>
                        <td><strong>@Html.DisplayFor(modelItem => item.Name)</strong></td>
                        <td>@Html.DisplayFor(modelItem => item.Address)</td>
                        <td>@Html.DisplayFor(modelItem => item.Phone)</td>
                        <td>@Html.DisplayFor(modelItem => item.Birthdate)</td>
                        <td>
                            <div class="d-flex gap-1">
                                <a asp-action="Edit" asp-route-id="@item.ClientId" class="btn btn-sm btn-outline-secondary">Edit</a>
                                <a asp-action="Details" asp-route-id="@item.ClientId" class="btn btn-sm btn-outline-info">Details</a>
                                <a asp-action="Delete" asp-route-id="@item.ClientId" class="btn btn-sm btn-outline-danger">Delete</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>