@model CarService.Models.Client

@{
    ViewData["Title"] = "Клиент";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Клиент</h4>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model?.ClientId" class="btn btn-sm btn-outline-secondary">Edit</a>
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary">← Назад</a>
    </div>
</div>

<div style="border:1px solid #dee2e6; border-radius:8px; overflow:hidden;">
    <dl class="row mb-0">
        <dt class="col-sm-3 bg-light px-3 py-2 mb-0 text-muted small border-bottom">@Html.DisplayNameFor(model => model.DocumentId)</dt>
        <dd class="col-sm-9 px-3 py-2 mb-0 border-bottom">@Html.DisplayFor(model => model.DocumentId)</dd>
        <dt class="col-sm-3 bg-light px-3 py-2 mb-0 text-muted small border-bottom">@Html.DisplayNameFor(model => model.Name)</dt>
        <dd class="col-sm-9 px-3 py-2 mb-0 border-bottom"><strong>@Html.DisplayFor(model => model.Name)</strong></dd>
        <dt class="col-sm-3 bg-light px-3 py-2 mb-0 text-muted small border-bottom">@Html.DisplayNameFor(model => model.Address)</dt>
        <dd class="col-sm-9 px-3 py-2 mb-0 border-bottom">@Html.DisplayFor(model => model.Address)</dd>
        <dt class="col-sm-3 bg-light px-3 py-2 mb-0 text-muted small border-bottom">@Html.DisplayNameFor(model => model.Phone)</dt>
        <dd class="col-sm-9 px-3 py-2 mb-0 border-bottom">@Html.DisplayFor(model => model.Phone)</dd>
        <dt class="col-sm-3 bg-light px-3 py-2 mb-0 text-muted small">@Html.DisplayNameFor(model => model.Birthdate)</dt>
        <dd class="col-sm-9 px-3 py-2 mb-0">@Html.DisplayFor(model => model.Birthdate)</dd>
    </dl>
</div>