@model CarService.Models.Product

@{
    ViewData["Title"] = "Create";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Создание товара</h4>
    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">← Назад</a>
</div>

<div style="border:1px solid #dee2e6; border-radius:8px; overflow:hidden; max-width:520px;">
    @using (Html.BeginForm("Create", "Products", FormMethod.Post, new { id = "productForm", @class = "p-3" }))
    {
        @Html.ValidationSummary(false, "", new { @class = "text-danger small mb-2" })

        <div class="mb-3">
            @Html.LabelFor(m => m.CategoryId, new { @class = "form-label small text-muted" })
            @Html.DropDownListFor(m => m.CategoryId, (SelectList)ViewBag.CategoryId, "Выбор категории", new { @class = "form-select form-select-sm", id = "categoryId" })
            @Html.ValidationMessageFor(m => m.CategoryId, "", new { @class = "text-danger small" })
        </div>

        <div class="mb-3">
            @Html.LabelFor(m => m.SerialNumber, new { @class = "form-label small text-muted" })
            @Html.TextBoxFor(m => m.SerialNumber, new { @class = "form-control form-control-sm", id = "serialNumber", placeholder = "111111" })
            @Html.ValidationMessageFor(m => m.SerialNumber, "", new { @class = "text-danger small" })
        </div>

        <div class="mb-3">
            @Html.LabelFor(m => m.Price, new { @class = "form-label small text-muted" })
            @Html.TextBoxFor(m => m.Price, new { @class = "form-control form-control-sm", id = "price", placeholder = "2707.0" })
            @Html.ValidationMessageFor(m => m.Price, "", new { @class = "text-danger small" })
        </div>

        <div class="mb-3">
            @Html.LabelFor(m => m.ReleaseYear, new { @class = "form-label small text-muted" })
            @Html.TextBoxFor(m => m.ReleaseYear, new { @class = "form-control form-control-sm", id = "releaseYear", placeholder = "1997" })
            @Html.ValidationMessageFor(m => m.ReleaseYear, "", new { @class = "text-danger small" })
        </div>

        <div class="mb-3">
            @Html.LabelFor(m => m.Brand, new { @class = "form-label small text-muted" })
            @Html.TextBoxFor(m => m.Brand, new { @class = "form-control form-control-sm", id = "brand", placeholder = "Michelin" })
            @Html.ValidationMessageFor(m => m.Brand, "", new { @class = "text-danger small" })
        </div>

        <div class="mb-3">
            @Html.LabelFor(m => m.Model, new { @class = "form-label small text-muted" })
            @Html.TextBoxFor(m => m.Model, new { @class = "form-control form-control-sm", id = "model", placeholder = "Pilot Sport" })
            @Html.ValidationMessageFor(m => m.Model, "", new { @class = "text-danger small" })
        </div>

        <input type="submit" value="Создать" class="btn btn-sm btn-dark" id="create" />
    }
</div>

<script>
    $('#create').click(function (e) {

        e.preventDefault();

        $('.field-validation-error').text('');

        let jsonData = JSON.stringify({
            'categoryId': $('#categoryId').val(),
            'serialNumber': $('#serialNumber').val(),
            'price': $('#price').val().replace(',', '.'),
            'releaseYear': $('#releaseYear').val(),
            'brand': $('#brand').val(),
            'model': $('#model').val()
        });

        $.ajax({
            url: '/Products/ValidateProduct',
            method: 'post',
            dataType: 'JSON',
            contentType: 'application/json',
            cache: false,
            processData: false,
            data: jsonData,

            success: function (data) {

                if (data.success == true) {
                    $('#productForm').submit();
                }
                else {

                    let errors = data.errors;

                    for (let key in errors) {

                        let span = $(`[data-valmsg-for="${key}"]`);

                        span.text(errors[key]);
                    }
                }
            }
        });
    });
</script>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
}