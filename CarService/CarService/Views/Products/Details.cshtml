@model CarService.Models.Product

@{
    ViewData["Title"] = "Товар";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Товар</h4>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model?.ProductId" class="btn btn-sm btn-outline-secondary">Edit</a>
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary">← Назад</a>
    </div>
</div>

<div style="border:1px solid #dee2e6; border-radius:8px; overflow:hidden;">
    <dl class="row mb-0">
        <dt class="col-sm-3 bg-light px-3 py-2 mb-0 text-muted small border-bottom">@Html.DisplayNameFor(model => model.SerialNumber)</dt>
        <dd class="col-sm-9 px-3 py-2 mb-0 border-bottom">@Html.DisplayFor(model => model.SerialNumber)</dd>
        <dt class="col-sm-3 bg-light px-3 py-2 mb-0 text-muted small border-bottom">@Html.DisplayNameFor(model => model.Price)</dt>
        <dd class="col-sm-9 px-3 py-2 mb-0 border-bottom"><strong>@Html.DisplayFor(model => model.Price)</strong></dd>
        <dt class="col-sm-3 bg-light px-3 py-2 mb-0 text-muted small border-bottom">@Html.DisplayNameFor(model => model.ReleaseYear)</dt>
        <dd class="col-sm-9 px-3 py-2 mb-0 border-bottom">@Html.DisplayFor(model => model.ReleaseYear)</dd>
        <dt class="col-sm-3 bg-light px-3 py-2 mb-0 text-muted small border-bottom">@Html.DisplayNameFor(model => model.Brand)</dt>
        <dd class="col-sm-9 px-3 py-2 mb-0 border-bottom">@Html.DisplayFor(model => model.Brand)</dd>
        <dt class="col-sm-3 bg-light px-3 py-2 mb-0 text-muted small border-bottom">@Html.DisplayNameFor(model => model.Model)</dt>
        <dd class="col-sm-9 px-3 py-2 mb-0 border-bottom">@Html.DisplayFor(model => model.Model)</dd>
        <dt class="col-sm-3 bg-light px-3 py-2 mb-0 text-muted small">@Html.DisplayNameFor(model => model.Category)</dt>
        <dd class="col-sm-9 px-3 py-2 mb-0"><span class="badge bg-secondary bg-opacity-10 text-secondary fw-normal">@Html.DisplayFor(model => model.Category.CategoryId)</span></dd>
    </dl>
</div>