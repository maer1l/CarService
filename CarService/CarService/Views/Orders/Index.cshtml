@model CarService.ViewModels.OrdersViewModel

@{
    ViewData["Title"] = "Заказы";
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h1 class="h4 mb-0">Заказы</h1>
    <div class="d-flex gap-2 align-items-center flex-wrap">
        <a asp-action="Create" class="btn btn-sm btn-outline-secondary">+ Создать</a>
        <form data-ajax="true" data-ajax-method="post" data-ajax-url="/Orders/SearchOrder" data-ajax-update="#results">
            <div class="d-flex gap-2">
                <input type="text" name="word" placeholder="Поиск..." class="form-control form-control-sm" style="width:220px;" />
                <button type="submit" class="btn btn-sm btn-outline-secondary">🔍</button>
            </div>
        </form>
    </div>
</div>

<div id="results">
    <div style="border:1px solid #dee2e6; border-radius:8px; overflow:hidden;">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>@Html.DisplayNameFor(model => model.orders.FirstOrDefault().MasterId)</th>
                    <th>@Html.DisplayNameFor(model => model.orders.FirstOrDefault().StartDate)</th>
                    <th>@Html.DisplayNameFor(model => model.orders.FirstOrDefault().EndDate)</th>
                    <th>@Html.DisplayNameFor(model => model.orders.FirstOrDefault().Price)</th>
                    <th>@Html.DisplayNameFor(model => model.orders.FirstOrDefault().Client)</th>
                    <th>@Html.DisplayNameFor(model => model.orders.FirstOrDefault().Product)</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.orders)
                {
                    <tr>
                        <td><span class="badge bg-primary bg-opacity-10 text-primary fw-normal">@Html.DisplayFor(modelItem => Model.masters[item.MasterId])</span></td>
                        <td>@Html.DisplayFor(modelItem => item.StartDate)</td>
                        <td>@Html.DisplayFor(modelItem => item.EndDate)</td>
                        <td><strong>@Html.DisplayFor(modelItem => item.Price)</strong></td>
                        <td>@Html.DisplayFor(modelItem => item.Client.Name)</td>
                        <td>@Html.DisplayFor(modelItem => item.Product.Model)</td>
                        <td>
                            <div class="d-flex gap-1">
                                <a asp-action="Edit" asp-route-id="@item.OrderId" class="btn btn-sm btn-outline-secondary">Edit</a>
                                <a asp-action="Details" asp-route-id="@item.OrderId" class="btn btn-sm btn-outline-info">Details</a>
                                <a asp-action="Delete" asp-route-id="@item.OrderId" class="btn btn-sm btn-outline-danger">Delete</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>