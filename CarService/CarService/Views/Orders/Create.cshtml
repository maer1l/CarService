@model CarService.Models.Order

@{
    ViewData["Title"] = "Create";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Создание заказа</h4>
    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">← Назад</a>
</div>

<div style="border:1px solid #dee2e6; border-radius:8px; overflow:hidden; max-width:520px;">
    <form asp-action="Create" class="p-3">

        <div asp-validation-summary="ModelOnly"
             class="text-danger small mb-2">
        </div>

        <div class="mb-3">
            <label asp-for="ProductId" class="form-label small text-muted"></label>

            <select asp-for="ProductId" class="form-select form-select-sm" asp-items="ViewBag.ProductId"></select>

            <span asp-validation-for="ProductId" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="MasterId" class="form-label small text-muted"></label>

            <select asp-for="MasterId" class="form-select form-select-sm" asp-items="ViewBag.MasterId"></select>

            <span asp-validation-for="MasterId" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="ClientId" class="form-label small text-muted"></label>

            <select asp-for="ClientId" class="form-select form-select-sm" asp-items="ViewBag.ClientId"></select>

            <span asp-validation-for="ClientId" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="StartDate" class="form-label small text-muted"></label>

            <input asp-for="StartDate" class="form-control form-control-sm" />

            <span asp-validation-for="StartDate" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="EndDate" class="form-label small text-muted"></label>

            <input asp-for="EndDate" class="form-control form-control-sm" />

            <span asp-validation-for="EndDate" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Price" class="form-label small text-muted"></label>

            <input asp-for="Price" class="form-control form-control-sm" />

            <span asp-validation-for="Price" class="text-danger small"></span>
        </div>

        <input type="submit" value="Создать" class="btn btn-sm btn-dark" />
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}