@model CarService.Models.Order

@{
    ViewData["Title"] = "Edit";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Редактирование</h4>
    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">← Назад</a>
</div>

<div style="border:1px solid #dee2e6; border-radius:8px; overflow:hidden; max-width:480px;">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="OrderId" />
            <div class="mb-3">
                <label asp-for="ProductId" class="control-label"></label>
                <select asp-for="ProductId" class="form-control" asp-items="ViewBag.ProductId"></select>
                <span asp-validation-for="ProductId" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="MasterId" class="control-label"></label>
                <select asp-for="MasterId" class="form-control" asp-items="ViewBag.MasterId"></select>
                <span asp-validation-for="MasterId" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="ClientId" class="control-label"></label>
                <select asp-for="ClientId" class="form-control" asp-items="ViewBag.ClientId"></select>
                <span asp-validation-for="ClientId" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="StartDate" class="control-label"></label>
                <input asp-for="StartDate" class="form-control" />
                <span asp-validation-for="StartDate" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="EndDate" class="control-label"></label>
                <input asp-for="EndDate" class="form-control" />
                <span asp-validation-for="EndDate" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Price" class="control-label"></label>
                <input asp-for="Price" class="form-control" />
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>
            <input type="submit" value="Сохранить" class="btn btn-sm btn-dark" />
        </form>
</div>


@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
