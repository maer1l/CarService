@model CarService.ViewModels.ApplicationUserViewModel

@using (Html.BeginForm("EditUser", "Administration", FormMethod.Post))
{
    <div class="form-group">
        @Html.LabelFor(m => m.user.Email)
        @Html.TextBoxFor(m => m.user.Email, new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.user.Email, "", new { @class = "text-danger" })
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.user.FirstName)
        @Html.TextBoxFor(m => m.user.FirstName, new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.user.FirstName, "", new { @class = "text-danger" })
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.user.LastName)
        @Html.TextBoxFor(m => m.user.LastName, new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.user.LastName, "", new { @class = "text-danger" })
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.user.Age)
        @Html.TextBoxFor(m => m.user.Age, new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.user.Age, "", new { @class = "text-danger" })
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.user.DocumentId)
        @Html.TextBoxFor(m => m.user.DocumentId, new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.user.DocumentId, "", new { @class = "text-danger" })
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.RoleName)
        @Html.DropDownListFor(m => m.RoleName, new SelectList(Model.Roles, "Name", "Name"), $"{Model.RoleName}", new { @class = "form-control", id = "roleName" })
        @Html.ValidationMessageFor(m => m.RoleName)
    </div>

    @Html.HiddenFor(u => u.user.Id)

    <input type="submit" value="Сохранить" class="btn btn-primary" />
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}